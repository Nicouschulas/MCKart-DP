$execute if score #temp pcd.temp matches 1 positioned $(x) $(y) $(z) run particle minecraft:dust{color:[255,204,0],scale:1.0} ~ ~ ~ 0 0 0 0 1 force @a[gamemode=!spectator,scores={pcd.enable=1}]
$execute if score #temp pcd.temp matches 1 positioned $(x) $(y) $(z) rotated $(rx) $(ry) run particle minecraft:dust{color:[255,204,0],scale:1.0} ^ ^ ^0.2 0 0 0 0 1 force @a[gamemode=!spectator,scores={pcd.enable=1}]
$execute if score #temp pcd.temp matches 1 positioned $(x) $(y) $(z) rotated $(rx) $(ry) run particle minecraft:dust{color:[255,204,0],scale:1.0} ^ ^ ^0.4 0 0 0 0 1 force @a[gamemode=!spectator,scores={pcd.enable=1}]
$execute if score #temp pcd.temp matches 2 positioned $(x) $(y) $(z) run particle minecraft:end_rod ~ ~ ~ 0 0 0 0 1 force @a[gamemode=!spectator,scores={pcd.enable=1}]